rule intermediate_dataset_after_filter:
    input:
        notebook="workflow/notebooks/1_after_{dataname}.py.ipynb",
        data=rules.intermediate_dataset_before_filter.output.data,
        targetpop=rules.create_target_pop.output.data,
        display_util=display_util,
        util=util,
        configfile="config/config.yml",
    output:
        data="results/data/intermediate_{dataname}.pq",
        model="results/data/intermediate_{dataname}.yml",
    log:
        notebook="results/reports/checkpoints/1_afterfilter_{dataname}.ipynb",
    conda:
        "envs/main.yml"
    threads: 4
    message:
        "Processing intermediate dataset..."
    shell:
        """
        papermill \
            {input.notebook} \
            {log.notebook} \
            -p configfile {input.configfile} \
            -p input_data {input.data} \
            -p targetpop_data {input.targetpop} \
            -p display_util {input.display_util} \
            -p util {input.util} \
            -p output_data {output.data} \
            -p output_model {output.model} \
            -k python3
        """


rule combinebeforeafternotebook:
    input:
        before=rules.intermediate_dataset_before_filter.log.notebook,
        after=rules.intermediate_dataset_after_filter.log.notebook,
    output:
        temp("results/reports/data/1_{dataname}.ipynb"),
    threads: 1
    message:
        "Combining checkpoint notebooks..."
    run:
        nb1 = nbformat.read(input["before"], as_version=nbformat.NO_CONVERT)
        nb2 = nbformat.read(input["after"], as_version=nbformat.NO_CONVERT)
        nb1.cells.extend(nb2.cells)
        with warnings.catch_warnings():
            warnings.simplefilter("ignore", category=DuplicateCellId)
            _, nb3 = normalize(nb1)
        nbformat.write(nb3, output[0])


