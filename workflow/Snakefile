        data="results/data/checkpoints/beforefilter_intermediate_{dataname}.pq",
    log:
        notebook="results/reports/checkpoints/1_beforefilter_{dataname}.ipynb",
    conda:
        "envs/main.yml"
    threads: 4
    message:
        "Filtering intermediate dataset before processing..."
    shell:
        """
        papermill \
            {input.notebook} \
            {log.notebook} \
            -p input_data {input.data} \
            -p display_util {input.display_util} \
            -p util {input.util} \
            -p input_doc {input.doc} \
            -p output_data {output.data} \
            -k python3
        """


