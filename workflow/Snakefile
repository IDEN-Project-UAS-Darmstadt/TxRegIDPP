        longnametable2020="resources/docdata/20220120_TxReg_BED_v2020.1_DSB.html",
        longnametablealtdaten=(
            "resources/docdata/20190530_Tx-BED-Datensatzbeschreibung_v123.html"
        ),
        shortnametable=(
            "resources/docdata/20210813_GFL_Tx_Servicedatei_Shortnames.xlsx"
        ),
    output:
        "results/officialdoc.csv",
    log:
        notebook="results/reports/officialdoc.ipynb",
    conda:
        "envs/soup.yml"
    message:
        "Reading offical documentation..."
    shell:
        """
        papermill \
            {input.notebook} \
            {log.notebook} \
            -p longnametable2020 {input.longnametable2020} \
            -p longnametable2022 {input.longnametable2022} \
            -p longnametablealtdaten {input.longnametablealtdaten} \
            -p shortnametable {input.shortnametable} \
            -p output {output} \
            -k python3
        """


