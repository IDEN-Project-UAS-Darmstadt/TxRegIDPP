        util=util,
        targetpop=rules.create_target_pop.output.data,
    output:
        data="results/data/flat_consolidated.pq",
    log:
        notebook="results/reports/2_consolidate.ipynb",
    conda:
        "envs/main.yml"
    params:
        datanames=datanames,
    message:
        "Consolidating..."
    shell:
        """
        papermill \
            {input.notebook} \
            {log.notebook} \
            -p input_data "{input.data}" \
            -p input_model "{input.model}" \
            -p display_util {input.display_util} \
            -p util {input.util} \
            -p targetpop_data {input.targetpop} \
            -p datanames "{params.datanames}" \
            -p output_data {output.data} \
            -k python3
        """


